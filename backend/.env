# ==============================================================================
# FastAPI Backend Environment Variables - WiseAI Services
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# WiseAI Base Host
WISEAI_BASE_URL=https://dev-models.wiseai.wiseyak.com

# WiseAI LLM Endpoint
LLM_API_URL=https://dev-models.wiseai.wiseyak.com/v1/chat/completions
LLM_TIMEOUT=60.0
ENABLE_THINKING=false

# WiseAI ASR (Speech-to-Text) Endpoint (from allmodelsopenai.json)
ASR_API_URL=https://dev-models.wiseai.wiseyak.com/asr/transcribe-from-stream
ASR_TIMEOUT=30.0
ASR_LANGUAGE=en

# WiseAI TTS (Text-to-Speech) Endpoint (from allmodelsopenai.json)
TTS_API_URL=https://dev-models.wiseai.wiseyak.com/tts/generate_from_text
TTS_TIMEOUT=45.0
TTS_DEFAULT_VOICE=Prakash_0

# Local Docker PostgreSQL campaign store
CAMPAIGN_STORE_BACKEND=postgres
DATABASE_URL=postgresql://wiseai:wiseai_local_dev@127.0.0.1:5433/wiseai_campaigns
